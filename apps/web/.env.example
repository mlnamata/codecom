# --- Ukázka bez databáze (prompt 07). Hodnoty nejsou tajné, jsou i v .env.development a .env.production.

# Zdroj dat: demo (paměť procesu, obsah z obsah/javori-lhota) nebo payload (dodá prompt 01).
# Bez DATABASE_URI je výchozí demo.
CODEKOM_ZDROJ=demo
# Přepíše „dnešek“ ukázky (ISO datum nebo datum a čas). Výchozí 2026-11-04 12:00 Europe/Prague.
CODEKOM_DEMO_DNES=
# 1 zapne pruh „Ukázka CodeKom“ a ukázku administrace. Vkompiluje se při buildu.
NEXT_PUBLIC_UKAZKA=1
# Jediný původ povolený v CORS endpointů (aplikace v prohlížeči). [OVĚŘIT port Expo web]
CODEKOM_APP_ORIGIN=http://localhost:8081
# Adresa aplikace pro odkaz „Aplikace“ v pruhu ukázky (nepovinné).
NEXT_PUBLIC_APP_URL=
# Základ absolutních URL v odpovědích endpointů (nepovinné, jinak původ požadavku).
CODEKOM_VEREJNA_URL=
# Slug obce, kterou web obsluhuje (do multi-tenantu z promptu 01).
CODEKOM_OBEC=javori-lhota

# --- Skutečná data (prompt 01). Tajné hodnoty jen do .env, nikdy do gitu.

# Supabase: Project Settings > Database > Connection string.
# A long-running server (VPS, Docker) uses the session pooler on port 5432.
# Serverless hosting (Vercel) uses the transaction pooler on port 6543.
DATABASE_URI=postgresql://postgres.PROJECT:HESLO@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=5
# openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
OBEC_NAZEV=Obec Javoří Lhota
