# Supabase: Project Settings > Database > Connection string.
# A long-running server (VPS, Docker) uses the session pooler on port 5432.
# Serverless hosting (Vercel) uses the transaction pooler on port 6543.
DATABASE_URI=postgresql://postgres.PROJECT:HESLO@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=5
